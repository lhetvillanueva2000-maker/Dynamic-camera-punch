<?xml version="1.0" encoding="utf-8"?>
<!--
  Control panel. Everything the theme needs to be switched on, in the order it
  needs to happen: permissions, then shape, then the memory budget, with the
  live demonstration last because it is the one thing that is *not* the product.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="28dp"
        android:paddingBottom="34dp">

        <!-- ── Header ─────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tagline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/text_dim"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Master switch ──────────────────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/theme_title" />

                <TextView
                    android:id="@+id/theme_status"
                    style="@style/CardBody"
                    android:text="@string/theme_off" />
            </LinearLayout>

            <Switch
                android:id="@+id/theme_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- ── Permissions ────────────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <TextView style="@style/CardTitle" android:text="@string/setup_title" />

            <include layout="@layout/row_permission" android:id="@+id/row_overlay" />
            <include layout="@layout/row_permission" android:id="@+id/row_listener" />
            <include layout="@layout/row_permission" android:id="@+id/row_post" />
        </LinearLayout>

        <!-- ── Cutout variant ─────────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <TextView style="@style/CardTitle" android:text="@string/cutout_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/variant_a"
                    style="@style/Choice"
                    android:layout_marginEnd="8dp"
                    android:text="@string/variant_a" />

                <TextView
                    android:id="@+id/variant_b"
                    style="@style/Choice"
                    android:text="@string/variant_b" />
            </LinearLayout>

            <TextView
                android:id="@+id/variant_desc"
                style="@style/CardBody"
                android:layout_marginTop="10dp"
                android:text="@string/variant_b_desc" />
        </LinearLayout>

        <!-- ── Keep the island on screen ──────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="@string/always_title" />

                <TextView
                    android:id="@+id/always_desc"
                    style="@style/CardBody"
                    android:text="@string/always_off" />
            </LinearLayout>

            <Switch
                android:id="@+id/always_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- ── Memory ─────────────────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <TextView style="@style/CardTitle" android:text="@string/ram_title" />

            <com.dcp.punch.ui.MemoryGaugeView
                android:id="@+id/ram_gauge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/CardTitle" android:text="@string/auto_title" />
                    <TextView style="@style/CardBody" android:text="@string/auto_desc" />
                </LinearLayout>

                <Switch
                    android:id="@+id/auto_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ram_detail"
                style="@style/CardBody"
                android:layout_marginTop="12dp" />

            <TextView
                style="@style/CardBody"
                android:layout_marginTop="10dp"
                android:text="@string/ram_hint" />

            <TextView
                android:id="@+id/ram_honest"
                style="@style/CardFine"
                android:layout_marginTop="10dp"
                android:text="@string/ram_honest" />
        </LinearLayout>

        <!-- ── Start on boot ──────────────────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="@string/boot_title" />
                <TextView style="@style/CardBody" android:text="@string/boot_desc" />
            </LinearLayout>

            <Switch
                android:id="@+id/boot_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- ── Live demonstration ─────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <TextView style="@style/CardTitle" android:text="@string/demo_title" />

            <TextView
                android:id="@+id/demo_desc"
                style="@style/CardBody"
                android:text="@string/demo_desc" />

            <Button
                android:id="@+id/demo_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill"
                android:text="@string/demo_open"
                android:textAllCaps="false"
                android:textColor="@color/text" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
