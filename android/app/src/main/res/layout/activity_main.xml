<?xml version="1.0" encoding="utf-8"?>
<!--
  Control panel. Everything the theme needs to be switched on, in the order it
  needs to happen: permissions, then shape, then the memory budget, with the
  live demonstration last because it is the one thing that is *not* the product.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="28dp"
        android:paddingBottom="34dp">

        <!-- ── Header ─────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tagline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/text_dim"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Master switch ──────────────────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/theme_title" />

                <TextView
                    android:id="@+id/theme_status"
                    style="@style/CardBody"
                    android:text="@string/theme_off" />
            </LinearLayout>

            <Switch
                android:id="@+id/theme_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- ── Permissions ────────────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <TextView style="@style/CardTitle" android:text="@string/setup_title" />

            <include layout="@layout/row_permission" android:id="@+id/row_overlay" />
            <include layout="@layout/row_permission" android:id="@+id/row_listener" />
            <include layout="@layout/row_permission" android:id="@+id/row_post" />
        </LinearLayout>

        <!-- ── Cutout variant ─────────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <TextView style="@style/CardTitle" android:text="@string/cutout_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/variant_a"
                    style="@style/Choice"
                    android:layout_marginEnd="8dp"
                    android:text="@string/variant_a" />

                <TextView
                    android:id="@+id/variant_b"
                    style="@style/Choice"
                    android:text="@string/variant_b" />
            </LinearLayout>

            <TextView
                android:id="@+id/variant_desc"
                style="@style/CardBody"
                android:layout_marginTop="10dp"
                android:text="@string/variant_b_desc" />
        </LinearLayout>

        <!-- ── What the island shows ──────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/sources_title" />

                <TextView
                    android:id="@+id/functions_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/add_plus"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/functions_desc"
                style="@style/CardBody"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:id="@+id/sources_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ── Apps ───────────────────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/apps_title" />

                <TextView
                    android:id="@+id/apps_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/add_plus"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/apps_desc"
                style="@style/CardBody"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:id="@+id/apps_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ── Keep the island on screen ──────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="@string/always_title" />

                <TextView
                    android:id="@+id/always_desc"
                    style="@style/CardBody"
                    android:text="@string/always_off" />
            </LinearLayout>

            <Switch
                android:id="@+id/always_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- ── Show only on the island ────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/CardTitle" android:text="@string/hide_title" />

                    <TextView
                        android:id="@+id/hide_desc"
                        style="@style/CardBody"
                        android:text="@string/hide_off" />
                </LinearLayout>

                <Switch
                    android:id="@+id/hide_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <TextView
                style="@style/CardFine"
                android:layout_marginTop="10dp"
                android:text="@string/hide_warn" />
        </LinearLayout>

        <!-- ── Memory ─────────────────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <TextView style="@style/CardTitle" android:text="@string/ram_title" />

            <com.dcp.punch.ui.MemoryGaugeView
                android:id="@+id/ram_gauge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/CardTitle" android:text="@string/auto_title" />
                    <TextView style="@style/CardBody" android:text="@string/auto_desc" />
                </LinearLayout>

                <Switch
                    android:id="@+id/auto_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ram_detail"
                style="@style/CardBody"
                android:layout_marginTop="12dp" />

            <TextView
                style="@style/CardBody"
                android:layout_marginTop="10dp"
                android:text="@string/ram_hint" />

            <TextView
                android:id="@+id/ram_honest"
                style="@style/CardFine"
                android:layout_marginTop="10dp"
                android:text="@string/ram_honest" />
        </LinearLayout>

        <!-- ── Start on boot ──────────────────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="@string/boot_title" />
                <TextView style="@style/CardBody" android:text="@string/boot_desc" />
            </LinearLayout>

            <Switch
                android:id="@+id/boot_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- ── Live demonstration ─────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <TextView style="@style/CardTitle" android:text="@string/demo_title" />

            <TextView
                android:id="@+id/demo_desc"
                style="@style/CardBody"
                android:text="@string/demo_desc" />

            <Button
                android:id="@+id/demo_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill"
                android:text="@string/demo_open"
                android:textAllCaps="false"
                android:textColor="@color/text" />
        </LinearLayout>

        <!-- ── Footer ─────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="@string/made_by"
            android:textColor="@color/text_dim"
            android:textSize="12.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="72dp"
            android:gravity="center"
            android:text="@string/made_with"
            android:textColor="@color/text_faint"
            android:textSize="11.5sp" />

    </LinearLayout>
</ScrollView>

    <!-- ── Capacity, bottom right ─────────────────────────────────────
         Collapsed it is a small pill with a count. Tapped, it expands into
         the breakdown of what the current ceiling actually buys. -->
    <LinearLayout
        android:id="@+id/capacity_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:gravity="end">

        <LinearLayout
            android:id="@+id/capacity_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                style="@style/CardTitle"
                android:text="@string/capacity_title" />

            <TextView
                android:id="@+id/capacity_body"
                style="@style/CardBody"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/capacity_note"
                style="@style/CardFine"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/capacity_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_active"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
