<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab two: how the island looks and moves.

  The preview is pinned at the top of the scroll rather than floating, so a dial
  and its effect are on screen together for the ones that matter most — size,
  position, radius — and the rest are a short scroll away.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pane_look"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="26dp"
        android:paddingBottom="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/look_title"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            style="@style/CardBody"
            android:text="@string/look_desc"
            android:paddingBottom="14dp" />

        <!-- ── Live preview ───────────────────────────────────────── -->
        <com.dcp.punch.ui.IslandPreview
            android:id="@+id/island_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp" />

        <!-- ── Cutout shape ───────────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <TextView style="@style/CardTitle" android:text="@string/variant_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/variant_a"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pill"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/variant_a"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/variant_b"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/variant_b"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/variant_desc"
                style="@style/CardBody"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- ── Size and position ──────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">
            <TextView style="@style/CardTitle" android:text="@string/look_geometry" />
            <LinearLayout
                android:id="@+id/dials_geometry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ── Colour and surface ─────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">
            <TextView style="@style/CardTitle" android:text="@string/look_surface" />

            <LinearLayout
                android:id="@+id/colour_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:id="@+id/dials_surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ── Movement ───────────────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">
            <TextView style="@style/CardTitle" android:text="@string/look_motion" />

            <LinearLayout
                android:id="@+id/dials_motion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/CardTitle" android:text="@string/reduce_anim_title" />
                    <TextView style="@style/CardBody" android:text="@string/reduce_anim_desc" />
                </LinearLayout>

                <Switch
                    android:id="@+id/reduce_anim_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Notification behaviour ─────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">
            <TextView style="@style/CardTitle" android:text="@string/look_notif" />

            <LinearLayout
                android:id="@+id/notif_mode_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:id="@+id/dials_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/CardTitle" android:text="@string/glow_title" />
                    <TextView style="@style/CardBody" android:text="@string/glow_desc" />
                </LinearLayout>

                <Switch
                    android:id="@+id/glow_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Presets ────────────────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/presets_title" />

                <TextView
                    android:id="@+id/preset_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/presets_save"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView style="@style/CardBody" android:text="@string/presets_desc" />

            <EditText
                android:id="@+id/preset_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill"
                android:hint="@string/presets_hint"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text_faint"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/presets_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/look_reset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/look_reset"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
