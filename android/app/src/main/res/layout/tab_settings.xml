<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab three: who you are, what the device has, and everything that is a
  preference rather than a piece of content or a piece of styling.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pane_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="26dp"
        android:paddingBottom="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_settings"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="14dp" />

        <!-- ── Your name ──────────────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <TextView style="@style/CardTitle" android:text="@string/name_title" />
            <TextView style="@style/CardBody" android:text="@string/name_desc" />

            <EditText
                android:id="@+id/user_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill"
                android:hint="@string/name_hint"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text_faint"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- ── Device ─────────────────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/device_title" />

                <TextView
                    android:id="@+id/device_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/device_refresh"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/device_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp" />

            <TextView
                style="@style/CardFine"
                android:layout_marginTop="10dp"
                android:text="@string/device_note" />
        </LinearLayout>

        <!-- ── Memory ceiling ─────────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <TextView style="@style/CardTitle" android:text="@string/ram_title" />

            <com.dcp.punch.ui.MemoryGaugeView
                android:id="@+id/ram_gauge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/CardTitle" android:text="@string/auto_title" />
                    <TextView style="@style/CardBody" android:text="@string/auto_desc" />
                </LinearLayout>

                <Switch
                    android:id="@+id/auto_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ram_detail"
                style="@style/CardBody"
                android:layout_marginTop="12dp" />

            <TextView
                style="@style/CardBody"
                android:layout_marginTop="10dp"
                android:text="@string/ram_hint" />

            <TextView
                android:id="@+id/ram_honest"
                style="@style/CardFine"
                android:layout_marginTop="10dp"
                android:text="@string/ram_honest" />
        </LinearLayout>

        <!-- ── Show only on the island ────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/CardTitle" android:text="@string/hide_title" />

                    <TextView
                        android:id="@+id/hide_desc"
                        style="@style/CardBody"
                        android:text="@string/hide_off" />
                </LinearLayout>

                <Switch
                    android:id="@+id/hide_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <TextView
                style="@style/CardFine"
                android:layout_marginTop="10dp"
                android:text="@string/hide_warn" />
        </LinearLayout>

        <!-- ── Keep the island on screen ──────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="@string/always_title" />

                <TextView
                    android:id="@+id/always_desc"
                    style="@style/CardBody"
                    android:text="@string/always_off" />
            </LinearLayout>

            <Switch
                android:id="@+id/always_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- ── Start on boot ──────────────────────────────────────── -->
        <LinearLayout
            style="@style/Card"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="@string/boot_title" />
                <TextView style="@style/CardBody" android:text="@string/boot_desc" />
            </LinearLayout>

            <Switch
                android:id="@+id/boot_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- ── Support ────────────────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <TextView style="@style/CardTitle" android:text="@string/support_title" />
            <TextView style="@style/CardBody" android:text="@string/support_desc" />

            <Button
                android:id="@+id/support_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill_active"
                android:text="@string/support_open"
                android:textAllCaps="false"
                android:textColor="@color/text" />
        </LinearLayout>

        <!-- ── Live demonstration ─────────────────────────────────── -->
        <LinearLayout style="@style/Card" android:orientation="vertical">

            <TextView style="@style/CardTitle" android:text="@string/demo_title" />

            <TextView
                android:id="@+id/demo_desc"
                style="@style/CardBody"
                android:text="@string/demo_desc" />

            <Button
                android:id="@+id/demo_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill"
                android:text="@string/demo_open"
                android:textAllCaps="false"
                android:textColor="@color/text" />
        </LinearLayout>

        <!-- ── Footer ─────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/footer_by"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="@string/made_by"
            android:textColor="@color/text_dim"
            android:textSize="12.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/made_with"
            android:textColor="@color/text_faint"
            android:textSize="11.5sp" />
    </LinearLayout>
</ScrollView>
