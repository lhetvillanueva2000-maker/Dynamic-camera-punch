<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background layer. Full-bleed on purpose: the launcher masks it
  to whatever shape the device uses, so it must paint all 108×108dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0.0"  android:color="#FF2B2748" />
                <item android:offset="0.42" android:color="#FF312A5E" />
                <item android:offset="0.78" android:color="#FF5B2BB0" />
                <item android:offset="1.0"  android:color="#FF7F2FD6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
